# Copy this file to .env on the VPS and fill in real values.
# NEVER commit the real .env to git.

# --- Core ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=hbtraders.com,www.hbtraders.com
CSRF_TRUSTED_ORIGINS=https://hbtraders.com,https://www.hbtraders.com
TIME_ZONE=Asia/Kolkata

# --- Database (PostgreSQL) ---
DB_ENGINE=postgres
DB_NAME=hbtrader
DB_USER=hbtrader
DB_PASSWORD=change-me-strong-password
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# --- Security ---
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# --- Email (optional, defaults to console backend) ---
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
